{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug guard API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/guard",
      "runtimeArgs": ["--env-file-if-exists=../../.env", "--import", "tsx"],
      "program": "${workspaceFolder}/apps/guard/src/server.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug current test file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/guard",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug MCP server",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/packages/mcp-server/src/index.ts",
      "env": { "AGENTPAY_URL": "http://localhost:8080", "AGENTPAY_API_KEY": "apg_demo_shopping_assistant" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
