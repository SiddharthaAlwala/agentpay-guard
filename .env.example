# Copy to .env for local runs outside Docker (npm run dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentpay
REDIS_URL=redis://localhost:6379
ADMIN_TOKEN=local-dev-admin-token
# Public demo: seeds demo agents, enables attack scenarios, opens dashboard controls. Fake money only.
DEMO_MODE=true
# Optional: second-opinion prompt-injection classifier using Claude.
LLM_CLASSIFIER=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
RATE_LIMIT_PER_MIN=600
PENDING_APPROVAL_TTL_MIN=30
LOG_LEVEL=info
# Dashboard "Source" link
REPO_URL=
