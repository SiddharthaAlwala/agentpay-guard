{
  "name": "@agentpay/proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Spend Guard: a budget-enforcing proxy in front of the OpenAI and Anthropic APIs.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.proxy src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env.proxy src/migrate.ts",
    "cli": "tsx --env-file-if-exists=../../.env.proxy src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "tsx bench/overhead.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "openai": "^7.32.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
