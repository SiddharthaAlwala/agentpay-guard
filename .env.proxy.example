# Spend Guard proxy (apps/proxy). Copy to .env.proxy for `npm run dev:proxy`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spendguard
REDIS_URL=redis://localhost:6379
PORT=8090
# Master key(s) that encrypt customers' provider keys: comma-separated id:base64(32 bytes).
# Generate one with:  node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Left empty, a fixed development key is used (refused when NODE_ENV=production).
ENCRYPTION_KEYS=
# Protects /metrics, which shows spend by model. Leave empty locally.
METRICS_TOKEN=
LOG_LEVEL=info
# Only for the CLI's `setup` / `provider-key` commands; never committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
